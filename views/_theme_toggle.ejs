<button
  class="theme-toggle"
  type="button"
  data-action="toggle-theme"
  aria-label="Dark mode"
  aria-pressed="false"
  title="Switch to dark mode"
>
  <svg class="icon theme-icon theme-icon-moon" aria-hidden="true">
    <use href="#i-moon" />
  </svg>
  <svg class="icon theme-icon theme-icon-sun" aria-hidden="true">
    <use href="#i-sun" />
  </svg>
</button>
