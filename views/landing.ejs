<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173e35" />
    <meta
      name="description"
      content="Explore Metro Manila universities, 637 degree programs, entrance exams, and admissions requirements with UniMatch PH."
    />
    <meta property="og:title" content="UniMatch PH — Find the right Manila university" />
    <meta
      property="og:description"
      content="Explore Metro Manila colleges, compare universities, discover degree programs, and find your match with UniMatch PH."
    />
    <title>UniMatch PH — Find the right Manila university</title>
    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/static/style.css" />
    <link rel="stylesheet" href="/static/landing.css" />
    <link rel="stylesheet" href="/static/theme-dark.css" />
    <script src="/static/theme.js"></script>
    <script type="module" src="/static/firebase-client.js"></script>
  </head>
  <body class="welcome-page" data-account="<%= currentUser ? currentUser.id : 'guest' %>">
    <a class="skip-link" href="#main">Skip to content</a>
    <%- include('_icons') %>

    <header class="welcome-header">
      <nav class="welcome-nav" aria-label="Main navigation">
        <a class="welcome-brand" href="/" aria-label="UniMatch PH home">
          <span class="welcome-brand-mark" aria-hidden="true">
            <svg class="brand-logo"><use href="#i-logo" /></svg>
          </span>
          <span>UniMatch<span class="brand-ph">PH</span></span>
        </a>
        <div class="welcome-nav-links">
          <a class="welcome-text-link" href="/explore">Universities</a>
          <a class="welcome-text-link" href="/explore#programs">Programs</a>
          <a class="welcome-text-link" href="/explore#recommend">Find my match</a>
        </div>
        <div class="welcome-nav-actions">
          <%- include('_theme_toggle') %>
          <% if (currentUser) { %>
            <a class="welcome-text-link" href="/profile">My profile</a>
            <a class="welcome-pill" href="/explore">Open directory</a>
          <% } else { %>
            <a class="welcome-text-link" href="/cloud-profile" data-cloud-signed-in hidden>Profile</a>
            <a class="welcome-pill" href="/explore" data-cloud-signed-in hidden>Open directory</a>
            <a class="welcome-text-link" href="/login?next=%2Fexplore" data-cloud-signed-out>Log in</a>
            <a class="welcome-pill" href="/explore" data-cloud-signed-out>Explore now</a>
          <% } %>
        </div>
      </nav>
    </header>

    <main class="welcome-main" id="main" tabindex="-1">
      <section class="welcome-hero" aria-labelledby="welcome-title">
        <div class="welcome-copy">
          <% if (currentUser) { %>
            <h1 id="welcome-title">Welcome back,<br /><em><%= accountName() %>.</em></h1>
            <p>
              Your saved universities, side-by-side comparisons, and degree
              matches are ready whenever you are.
            </p>
            <div class="welcome-actions">
              <a class="button primary welcome-primary" href="/explore">
                Continue exploring<svg class="icon"><use href="#i-arrow" /></svg>
              </a>
              <a class="button secondary welcome-secondary" href="/explore#recommend">
                Find my match
              </a>
            </div>
          <% } else { %>
            <h1 id="welcome-title">Find the right Manila<br />university <em>for you.</em></h1>
            <p>
              Browse degree programs, check entrance exams and requirements, and
              compare Metro Manila schools side by side — all sourced from
              official university pages.
            </p>
            <div class="welcome-actions">
              <a class="button primary welcome-primary" href="/explore">
                Explore 15 universities<svg class="icon"><use href="#i-arrow" /></svg>
              </a>
              <a class="button secondary welcome-secondary" href="/explore#recommend">
                Find my match
              </a>
            </div>
          <% } %>

          <div class="welcome-stats" aria-label="Directory coverage">
            <div>
              <strong>15</strong>
              <span>Metro Manila universities</span>
            </div>
            <div>
              <strong>637</strong>
              <span>Undergraduate programs</span>
            </div>
            <div>
              <strong>5</strong>
              <span>Free-tuition public schools</span>
            </div>
          </div>
        </div>

        <div class="welcome-art" aria-hidden="true">
          <img
            src="/static/campus.svg"
            alt=""
            width="430"
            height="330"
          />
        </div>
      </section>
    </main>

    <footer class="welcome-footer">
      <div class="welcome-footer-bottom">
        <span>UniMatch PH · Metro Manila college directory</span>
        <nav class="welcome-footer-links" aria-label="Footer links">
          <a href="/explore">Explore</a>
          <a href="/explore?notes=1">About the data</a>
          <a href="/register?next=%2Fexplore">Create free account</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
