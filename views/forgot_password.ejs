<%- include('_account_header') %>
  <section class="account-card account-card-narrow">
    <span class="account-eyebrow">ACCOUNT RECOVERY</span>
    <h1>Forgot your password?</h1>
    <p class="account-lead">Enter the email address on your account. If it matches, we will send a reset link that expires in 30 minutes.</p>
    <% if (submitted) { %>
      <p class="account-alert success" role="status">If an account exists for that address, a reset link has been sent. Check your inbox and spam folder.</p>
      <% if (dev_reset_link) { %>
        <p class="account-help">Development mode: SMTP is not configured, so use this link directly. It expires in 30 minutes.</p>
        <p class="account-secret"><a href="<%= dev_reset_link %>"><%= dev_reset_link %></a></p>
      <% } %>
      <p class="account-switch"><a href="/login">Back to log in</a></p>
    <% } else { %>
      <form method="post" action="/forgot-password" class="account-form" novalidate>
        <input type="hidden" name="csrf_token" value="<%= csrfToken() %>" />
        <label for="forgot-email">Email address</label>
        <input id="forgot-email" name="email" type="email" maxlength="254" autocomplete="email" required />
        <button class="button primary" type="submit">Send reset link</button>
      </form>
      <p class="account-switch"><a href="/login">Back to log in</a></p>
    <% } %>
  </section>
<%- include('_account_footer') %>
