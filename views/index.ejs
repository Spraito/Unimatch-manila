<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173e35" />
    <meta
      name="description"
      content="Explore Metro Manila colleges, compare universities, and discover degree programs with UniMatch PH."
    />
    <meta property="og:title" content="UniMatch PH — Find your next chapter" />
    <meta
      property="og:description"
      content="Explore Metro Manila colleges, compare universities, and discover degree programs with UniMatch PH."
    />
    <title>UniMatch PH — Find your next chapter</title>
    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/static/style.css" />
    <link rel="stylesheet" href="/static/theme-dark.css" />
    <script src="/static/theme.js"></script>
    <script type="module" src="/static/app.js"></script>
    <script type="module" src="/static/firebase-client.js"></script>
  </head>
  <body
    data-account="<%= currentUser ? currentUser.id : 'guest' %>"
    data-csrf-token="<%= csrfToken() %>"
    data-initial-view="<%= typeof initialView !== 'undefined' && initialView ? initialView : '' %>"
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <%- include('_icons') %>
    <button
      class="sidebar-shade"
      id="sidebar-shade"
      aria-label="Close navigation"
      hidden
    ></button>
    <aside class="sidebar" id="sidebar" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="UniMatch PH home"
        ><span class="brand-icon"
          ><svg class="brand-logo"><use href="#i-logo" /></svg></span
        ><span>UniMatch<span class="brand-ph">PH</span></span></a
      >
      <nav class="navigation" aria-label="Directory sections">
        <button
          class="nav-item active"
          data-view="universities"
          aria-current="page"
        >
          <svg class="icon"><use href="#i-grid" /></svg>Explore colleges
        </button>
        <button class="nav-item" data-view="programs">
          <svg class="icon"><use href="#i-book" /></svg>Degree programs
        </button>
        <button class="nav-item" data-view="recommend">
          <svg class="icon"><use href="#i-spark" /></svg>Find my match
        </button>
        <button class="nav-item" data-view="compare">
          <svg class="icon"><use href="#i-compare" /></svg>Compare<span
            class="nav-count"
            id="compare-count"
            >0</span
          >
        </button>
        <button class="nav-item" data-view="saved">
          <svg class="icon"><use href="#i-save" /></svg>Saved<span
            class="nav-count"
            id="saved-count"
            >0</span
          >
        </button>
        <button class="nav-item" data-view="calendar">
          <svg class="icon"><use href="#i-calendar" /></svg>Calendar<span
            class="nav-count"
            id="calendar-count"
            >0</span
          >
        </button>
      </nav>

      <div class="sidebar-bottom">
        <button class="sidebar-about-link" data-action="notes">
          <svg class="icon"><use href="#i-info" /></svg>About the data
        </button>
        <div class="sidebar-footer">
          <span class="guest-avatar" data-cloud-avatar aria-hidden="true"><%= currentUser ? accountInitial() : 'G' %></span>
          <div class="sidebar-account-info">
            <% if (currentUser) { %>
              <strong><%= accountName() %></strong>
              <span class="sidebar-account-links">
                <a href="/profile">My profile</a>
                <% if (currentUser.role === 'admin') { %>
                  <a href="/admin/dashboard"> · Admin</a>
                <% } %>
              </span>
            <% } else { %>
              <strong data-cloud-signed-in data-cloud-display-name hidden>Student</strong>
              <span class="sidebar-account-links" data-cloud-signed-in hidden>
                <a href="/cloud-profile">Profile</a>
                <a href="/admin/dashboard" data-cloud-admin-only hidden> · Admin</a>
              </span>
              <strong data-cloud-signed-out>Guest mode</strong>
              <span class="sidebar-account-links" data-cloud-signed-out>
                <a href="/login">Log in</a> · <a href="/register">Sign up</a>
              </span>
            <% } %>
          </div>
        </div>
      </div>
    </aside>

    <div class="app-shell">
      <header class="topbar">
        <div class="breadcrumb">
          <button
            class="icon-button mobile-menu"
            id="menu-toggle"
            aria-label="Open navigation"
            aria-controls="sidebar"
            aria-expanded="false"
          >
            <svg class="icon"><use href="#i-menu" /></svg></button
          ><strong id="breadcrumb-view">Explore colleges</strong>
        </div>
        <div class="topbar-right">
          <button
            type="button"
            class="topbar-notif-btn"
            id="topbar-notif-btn"
            data-action="open-notifications"
            aria-label="Open admission reminder notifications"
          >
            <svg class="icon"><use href="#i-bell" /></svg>
            <span class="topbar-notif-label">Reminders</span>
            <span class="topbar-notif-count" id="notif-count" hidden>0</span>
          </button>
          <% if (currentUser) { %>
            <% if (currentUser.role === 'admin') { %>
              <a class="topbar-account" href="/admin/dashboard">Admin dashboard</a>
            <% } %>
            <a class="topbar-account" href="/profile"><%= accountName() %></a>
          <% } else { %>
            <a class="topbar-account" href="/admin/dashboard" data-cloud-admin-only hidden>Admin dashboard</a>
            <a class="topbar-account" href="/cloud-profile" data-cloud-signed-in hidden><span data-cloud-display-name>Student</span></a>
            <a class="topbar-account" href="/login" data-cloud-signed-out>Log in</a>
          <% } %>
          <%- include('_theme_toggle') %>
        </div>
      </header>

      <main id="main" tabindex="-1">
        <section class="hero" id="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <h1 id="hero-title">Find your college in <em>Metro Manila.</em></h1>
            <p>
              Compare 15 universities, browse 637 degree programs, and check
              official entrance exams and requirements in one place.
            </p>
            <div class="hero-actions">
              <button class="button primary" data-view="recommend">
                Find my match<svg class="icon"><use href="#i-arrow" /></svg>
              </button>
              <button class="button secondary" data-view="programs">
                Browse degree programs
              </button>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <img
              src="/static/campus.svg"
              alt=""
              width="380"
              height="280"
            />
          </div>
        </section>

        <section class="explorer" aria-labelledby="section-title">
          <div class="section-heading" id="section-heading" hidden>
            <div>
              <h2 id="section-title">Explore universities</h2>
              <p id="section-description"></p>
            </div>
          </div>

          <div class="filter-bar" id="filter-bar">
            <label class="search-box"
              ><svg class="icon"><use href="#i-search" /></svg
              ><span class="sr-only" id="search-label"
                >Search universities or programs</span
              ><input
                id="search"
                aria-labelledby="search-label"
                type="search"
                placeholder="Search a university, degree, or entrance exam…"
                maxlength="200"
                autocomplete="off"
              /><span class="search-shortcut" aria-hidden="true">⌘K</span></label
            >
            <label class="select-label" id="city-wrap" hidden
              ><span class="sr-only">City</span
              ><select id="city">
                <option value="">All locations</option>
              </select></label
            >
            <label class="select-label" id="sector-wrap" hidden
              ><span class="sr-only">University type</span
              ><select id="sector">
                <option value="">All types</option>
                <option>Public</option>
                <option>Private</option>
              </select></label
            >
            <label class="select-label" id="school-wrap" hidden
              ><span class="sr-only">University</span
              ><select id="school">
                <option value="">All universities</option>
              </select></label
            >
            <label class="select-label" id="topic-wrap" hidden
              ><span class="sr-only">Program topic</span
              ><select id="topic">
                <option value="">All topics</option>
              </select></label
            >
          </div>

          <div class="quick-filters" id="quick-filters" role="group" aria-label="Quick filters"></div>

          <div class="results-meta" id="results-meta">
            <span id="results-count" role="status" aria-live="polite"
              >Loading universities…</span
            ><label class="sort-label" id="sort-wrap"
              >Sort
              <select id="sort" aria-label="Sort universities">
                <option value="featured">Most programs</option>
                <option value="name">Name, A–Z</option>
              </select></label
            >
          </div>

          <div id="results" aria-busy="true">
            <div class="loading-state">Loading universities…</div>
          </div>
          <div id="pagination" class="pagination" hidden></div>
        </section>

        <footer class="page-footer">
          <span>UniMatch PH · Confirm current dates and fees on each university’s official site.</span>
          <button class="footer-link-btn" data-action="notes">About the data</button>
        </footer>
        <noscript
          ><p class="error-state">
            Enable JavaScript to explore universities and degree programs.
          </p></noscript
        >
      </main>
    </div>

    <dialog
      id="school-dialog"
      class="detail-dialog"
      aria-labelledby="dialog-title"
    >
      <button
        class="dialog-close icon-button"
        data-action="close-dialog"
        aria-label="Close details"
      >
        <svg class="icon"><use href="#i-close" /></svg>
      </button>
      <div id="detail-body"></div>
    </dialog>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>
