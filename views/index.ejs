<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173e35" />
    <meta
      name="description"
      content="Explore Metro Manila colleges, compare universities, and discover degree programs with UniMatch PH."
    />
    <meta property="og:title" content="UniMatch PH — Find your next chapter" />
    <meta
      property="og:description"
      content="Explore Metro Manila colleges, compare universities, and discover degree programs with UniMatch PH."
    />
    <title>UniMatch PH — Find your next chapter</title>
    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/static/style.css" />
    <link rel="stylesheet" href="/static/theme-dark.css" />
    <script src="/static/theme.js"></script>
    <script type="module" src="/static/app.js"></script>
  </head>
  <body data-account="<%= currentUser ? currentUser.id : 'guest' %>">
    <a class="skip-link" href="#main">Skip to content</a>
    <%- include('_icons') %>
    <button
      class="sidebar-shade"
      id="sidebar-shade"
      aria-label="Close navigation"
      hidden
    ></button>
    <aside class="sidebar" id="sidebar" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="UniMatch PH home"
        ><span class="brand-icon"
          ><svg class="brand-logo"><use href="#i-logo" /></svg></span
        ><span>UniMatch<span class="brand-ph">PH</span></span></a
      >
      <div class="sidebar-label">YOUR COLLEGE JOURNEY</div>
      <nav class="navigation">
        <button
          class="nav-item active"
          data-view="universities"
          aria-current="page"
        >
          <svg class="icon"><use href="#i-grid" /></svg>Explore colleges
        </button>
        <button class="nav-item" data-view="programs">
          <svg class="icon"><use href="#i-book" /></svg>Degree programs
        </button>
        <button class="nav-item" data-view="recommend">
          <svg class="icon"><use href="#i-spark" /></svg>Find my match
        </button>
        <button class="nav-item" data-view="compare">
          <svg class="icon"><use href="#i-compare" /></svg>Compare schools<span
            class="nav-count"
            id="compare-count"
            >0</span
          >
        </button>
        <button class="nav-item" data-view="saved">
          <svg class="icon"><use href="#i-save" /></svg>Saved schools<span
            class="nav-count"
            id="saved-count"
            >0</span
          >
        </button>
      </nav>
      <div class="sidebar-note">
        <span class="tiny-star">✳</span>
        <h3>A big decision.<br />A clearer starting point.</h3>
        <p>
          Explore your options, keep your favorites, and take the next step.
        </p>
        <button data-action="notes">
          About the data <span aria-hidden="true">↗</span>
        </button>
      </div>
      <div class="sidebar-footer">
        <span class="guest-avatar">U</span>
        <div>
          <% if (currentUser) { %>
            <strong><%= accountName() %></strong>
            <a href="/profile">My profile</a>
          <% } else { %>
            <strong>Your exploration space</strong>
            <span><a href="/login">Log in</a> · <a href="/register">Register</a></span>
          <% } %>
        </div>
      </div>
    </aside>
    <div class="app-shell">
      <header class="topbar">
        <div class="breadcrumb">
          <button
            class="icon-button mobile-menu"
            id="menu-toggle"
            aria-label="Open navigation"
            aria-controls="sidebar"
            aria-expanded="false"
          >
            <svg class="icon"><use href="#i-menu" /></svg></button
          ><span>UniMatch PH</span><span class="breadcrumb-slash">/</span
          ><strong id="breadcrumb-view">Explore colleges</strong>
        </div>
        <div class="topbar-right">
          <% if (currentUser) { %>
            <a class="topbar-account" href="/profile">Hello, <%= accountName() %></a>
          <% } else { %>
            <a class="topbar-account" href="/login">Log in</a>
          <% } %>
          <span class="prototype-pill"><span></span>Research prototype</span
          ><button
            class="icon-button"
            data-action="notes"
            aria-label="About this dataset"
          >
            <svg class="icon"><use href="#i-info" /></svg>
          </button>
          <%- include('_theme_toggle') %>
        </div>
      </header>
      <main id="main" tabindex="-1">
        <section class="hero" id="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <span class="eyebrow"
              ><span class="little-line"></span> BIG DREAMS, LOCAL
              POSSIBILITIES</span
            >
            <h1 id="hero-title">
              Your next chapter<br />starts <em>here.</em>
            </h1>
            <p>
              Find a college that feels like you. Explore Metro Manila’s
              universities and the programs that could shape your future.
            </p>
            <button class="button primary" data-view="programs">
              Discover degree programs<svg class="icon">
                <use href="#i-arrow" />
              </svg>
            </button>
            <div class="hero-footnote">
              <svg class="icon"><use href="#i-pin" /></svg>Made for your Metro
              Manila college search
            </div>
          </div>
          <div class="hero-art">
            <img
              src="/static/campus.svg"
              alt=""
              width="430"
              height="330"
            />
            <div class="art-caption">
              <span class="caption-dot"></span> A world of possibilities, closer
              to home.
            </div>
          </div>
        </section>
        <section class="explorer" aria-labelledby="section-title">
          <div class="section-heading">
            <div>
              <span class="eyebrow section-eyebrow" id="section-eyebrow"
                >A PLACE TO BEGIN</span
              >
              <h2 id="section-title">Explore universities</h2>
              <p id="section-description">
                Different paths. New possibilities. Find your starting point.
              </p>
            </div>
            <span class="scope-pill"
              ><svg class="icon"><use href="#i-pin" /></svg>Metro Manila</span
            >
          </div>
          <div class="filter-bar" id="filter-bar">
            <label class="search-box"
              ><svg class="icon"><use href="#i-search" /></svg
              ><span class="sr-only" id="search-label"
                >Search universities or programs</span
              ><input
                id="search"
                aria-labelledby="search-label"
                type="search"
                placeholder="Search a university or program…"
                maxlength="200"
                autocomplete="off"
              /><span class="search-shortcut" aria-hidden="true"
                >⌘ / Ctrl K</span
              ></label
            >
            <label class="select-label" id="city-wrap"
              ><span class="sr-only">City</span
              ><select id="city">
                <option value="">All locations</option>
              </select></label
            >
            <label class="select-label" id="sector-wrap"
              ><span class="sr-only">University type</span
              ><select id="sector">
                <option value="">All types</option>
                <option>Public</option>
                <option>Private</option>
              </select></label
            >
            <label class="select-label" id="school-wrap" hidden
              ><span class="sr-only">University</span
              ><select id="school">
                <option value="">All universities</option>
              </select></label
            >
            <label class="select-label" id="topic-wrap" hidden
              ><span class="sr-only">Program topic</span
              ><select id="topic">
                <option value="">All topics</option>
              </select></label
            >
          </div>
          <div class="results-meta" id="results-meta">
            <span id="results-count" role="status" aria-live="polite"
              >Loading your possibilities…</span
            ><label class="sort-label" id="sort-wrap"
              >Sort by
              <select id="sort" aria-label="Sort universities">
                <option value="featured">Data coverage</option>
                <option value="name">Name, A–Z</option>
              </select></label
            >
          </div>
          <div id="results" aria-busy="true">
            <div class="loading-state">Loading universities…</div>
          </div>
          <div id="pagination" class="pagination" hidden></div>
        </section>
        <aside class="data-notice">
          <span class="notice-icon"
            ><svg class="icon"><use href="#i-info" /></svg
          ></span>
          <div>
            <strong>A starting point, with sources you can check.</strong>
            <p>
              Admissions can change. Collected information needs review; confirm
              dates, fees, and eligibility with each university.
            </p>
          </div>
          <button data-action="notes">
            Read data notes<svg class="icon"><use href="#i-arrow" /></svg>
          </button>
        </aside>
        <footer class="page-footer">
          <span
            >UniMatch PH <span class="footer-dot">·</span> A college admissions
            research prototype</span
          ><span>Made for the next chapter.</span>
        </footer>
        <noscript
          ><p class="error-state">
            Enable JavaScript to search universities and view collected
            admissions evidence.
          </p></noscript
        >
      </main>
    </div>
    <dialog
      id="school-dialog"
      class="detail-dialog"
      aria-labelledby="dialog-title"
    >
      <button
        class="dialog-close icon-button"
        data-action="close-dialog"
        aria-label="Close details"
      >
        <svg class="icon"><use href="#i-close" /></svg>
      </button>
      <div id="detail-body"></div>
    </dialog>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>
